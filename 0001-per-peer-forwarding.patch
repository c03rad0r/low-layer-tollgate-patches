+#[cfg(test)]
+mod price_tests {
+    use super::priced_cost;
+
+    #[test]
+    fn price_is_a_non_negative_multiplier() {
+        assert_eq!(priced_cost(1.5, 0.0), 1.5);
+        assert_eq!(priced_cost(1.5, 1.0), 3.0);
+        assert_eq!(priced_cost(1.5, -2.0), 1.5);
+        assert!(priced_cost(1.0, 0.5) > priced_cost(1.0, 0.0));
+    }
