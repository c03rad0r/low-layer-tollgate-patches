+    /// Set or clear a local price penalty for one peer.
+    ///
+    /// `price` is a non-negative multiplier addend applied to the peer's
+    /// measured link cost (`cost * (1 + price)`). The tree's parent selection
+    /// already compares effective depth with hysteresis, so this is a soft
+    /// preference: a price change forces one re-evaluation, but the hold-down
+    /// veto can still refuse the switch.
+    pub(crate) fn api_set_price(
+        &mut self,
+        npub: &str,
+        price: Option<f64>,
+    ) -> Result<serde_json::Value, String> {
+        let peer_identity =
+            PeerIdentity::from_npub(npub).map_err(|e| format!("invalid npub '{npub}': {e}"))?;
+        let node_addr = *peer_identity.node_addr();
+
+        match price {
+            None => {
+                self.link_prices.remove(&node_addr);
+            }
+            Some(value) => {
+                if !value.is_finite() || value < 0.0 {
+                    return Err(format!(
+                        "price must be a finite, non-negative number, got {value}"
+                    ));
+                }
+                self.link_prices.insert(node_addr, value);
+            }
+        }
+        self.price_revision = self.price_revision.wrapping_add(1);
+
+        info!(
+            npub = %npub,
+            peer = %node_addr,
+            price = ?price,
+            "API link price changed"
+        );
+
+        Ok(serde_json::json!({
+            "npub": npub,
+            "peer": node_addr.to_string(),
+            "price": price,
+            "effective_cost_factor": price.map(|p| 1.0 + p).unwrap_or(1.0),
+        }))
+    }
+
+    /// Admit, refuse or release a peer at runtime.
+    ///
+    /// `action` is `allow`, `deny` or `clear`. The override is checked before
+    /// the file ACL in [`Node::authorize_peer`], so it takes effect on the next
+    /// handshake rather than on the 1 s ACL-file tick. It is in-memory only; a
+    /// durable eviction must still write the ACL files.
+    pub(crate) fn api_set_admission(
+        &mut self,
+        npub: &str,
+        action: &str,
+    ) -> Result<serde_json::Value, String> {
+        let peer_identity =
+            PeerIdentity::from_npub(npub).map_err(|e| format!("invalid npub '{npub}': {e}"))?;
+        let node_addr = *peer_identity.node_addr();
+
+        let effect = match action {
+            "allow" | "allowed" => {
+                self.acl_overrides.insert(node_addr, true);
+                "allowed"
+            }
+            "deny" | "denied" | "block" | "blocked" => {
+                self.acl_overrides.insert(node_addr, false);
+                "denied"
+            }
+            "clear" | "reset" | "file" => {
+                self.acl_overrides.remove(&node_addr);
+                "cleared"
+            }
+            other => {
+                return Err(format!(
+                    "invalid action '{other}': expected allow, deny or clear"
+                ));
+            }
+        };
+
+        info!(
+            npub = %npub,
+            peer = %node_addr,
+            admission = effect,
+            "API runtime admission changed"
+        );
+
+        Ok(serde_json::json!({
+            "npub": npub,
+            "peer": node_addr.to_string(),
+            "admission": effect,
+        }))
+    }
+
+    /// Block or allow a peer's **transit** forwarding via the control API.
+    ///
+    /// Local delivery is never affected: the peer can still reach this node.
+    /// The block is independent of the peer table, so it survives a
+    /// disconnect/reconnect until explicitly cleared with `allow=true`.
+    pub(crate) fn api_set_forwarding(
+        &mut self,
+        npub: &str,
+        allow: bool,
+    ) -> Result<serde_json::Value, String> {
+        let peer_identity =
+            PeerIdentity::from_npub(npub).map_err(|e| format!("invalid npub '{npub}': {e}"))?;
+        let node_addr = *peer_identity.node_addr();
+
+        if !self.peers.contains_key(&node_addr) {
+            return Err(format!("peer not found: {npub}"));
+        }
+
+        if allow {
+            self.forwarding_blocked.remove(&node_addr);
+        } else {
+            self.forwarding_blocked.insert(node_addr);
+        }
+
+        info!(
+            npub = %npub,
+            peer = %node_addr,
+            forwarding = if allow { "allowed" } else { "blocked" },
+            "API peer forwarding policy changed"
+        );
+
+        Ok(serde_json::json!({
+            "npub": npub,
+            "peer": node_addr.to_string(),
+            "forwarding": if allow { "allowed" } else { "blocked" },
+        }))
+    }
+
