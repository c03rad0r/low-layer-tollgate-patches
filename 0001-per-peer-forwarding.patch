+    pub fn record_policy_blocked(&self, peer: crate::NodeAddr, bytes: usize) {
+        self.drop_policy_blocked_packets.inc();
+        self.drop_policy_blocked_bytes.add(bytes as u64);
+        if let Ok(mut by_peer) = self.policy_blocked_by_peer.lock() {
+            let entry = by_peer.entry(peer).or_default();
+            entry.packets += 1;
+            entry.bytes += bytes as u64;
