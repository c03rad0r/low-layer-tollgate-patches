+
+/// Apply a local price penalty to a measured link cost.
+///
+/// `price` is a non-negative multiplier addend: 0 leaves the MMP cost alone,
+/// 1 doubles it, and so on. Negative values clamp to 0 so a control command
+/// can never make a link look cheaper than measured.
+fn priced_cost(base: f64, price: f64) -> f64 {
+    base * (1.0 + price.max(0.0))
+}
+
+impl Node {
+    /// Measured link cost with this node's local price preference applied.
+    fn price_adjusted_cost(&self, addr: &NodeAddr, peer: &crate::peer::ActivePeer) -> f64 {
+        priced_cost(
+            peer.link_cost(),
+            self.link_prices.get(addr).copied().unwrap_or(0.0),
+        )
+    }
+}
