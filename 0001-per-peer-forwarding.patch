+/// Set or clear a peer's local price penalty.
+///
+/// Params: `{"npub": "npub1...", "price": <number>}`; `price: null` clears.
+fn set_price(node: &mut Node, params: Option<&Value>) -> Response {
+    let Some(params) = params else {
+        return Response::error("missing params for set_price");
+    };
+
+    let npub = match params.get("npub").and_then(|v| v.as_str()) {
+        Some(v) => v,
+        None => return Response::error("missing 'npub' parameter"),
+    };
+    let price = match params.get("price") {
+        None | Some(Value::Null) => None,
+        Some(value) => match value.as_f64() {
+            Some(v) => Some(v),
+            None => return Response::error("'price' must be a number or null"),
+        },
+    };
+
+    match node.api_set_price(npub, price) {
+        Ok(data) => Response::ok(data),
+        Err(msg) => Response::error(msg),
+    }
+}
+
+/// Admit, refuse or release a peer at runtime.
+///
+/// Params: `{"npub": "npub1...", "action": "allow" | "deny" | "clear"}`
+fn set_admission(node: &mut Node, params: Option<&Value>) -> Response {
+    let Some(params) = params else {
+        return Response::error("missing params for set_admission");
+    };
+
+    let npub = match params.get("npub").and_then(|v| v.as_str()) {
+        Some(v) => v,
+        None => return Response::error("missing 'npub' parameter"),
+    };
+    let action = match params.get("action").and_then(|v| v.as_str()) {
+        Some(v) => v,
+        None => return Response::error("missing 'action' parameter"),
+    };
+
+    debug!(npub = %npub, action = %action, "API runtime admission requested");
+
+    match node.api_set_admission(npub, action) {
+        Ok(data) => Response::ok(data),
+        Err(msg) => Response::error(msg),
+    }
+}
+
+/// Block or allow a peer's transit forwarding.
+///
+/// Params: `{"npub": "npub1...", "allow": false}`
+fn set_forwarding(node: &mut Node, params: Option<&Value>) -> Response {
+    let Some(params) = params else {
+        return Response::error("missing params for set_forwarding");
+    };
+
+    let npub = match params.get("npub").and_then(|v| v.as_str()) {
+        Some(v) => v,
+        None => return Response::error("missing 'npub' parameter"),
+    };
+    let allow = match params.get("allow").and_then(|v| v.as_bool()) {
+        Some(v) => v,
+        None => return Response::error("missing 'allow' boolean parameter"),
+    };
+
+    debug!(npub = %npub, allow = allow, "API forwarding policy requested");
+
+    match node.api_set_forwarding(npub, allow) {
+        Ok(data) => Response::ok(data),
+        Err(msg) => Response::error(msg),
+    }
+}
