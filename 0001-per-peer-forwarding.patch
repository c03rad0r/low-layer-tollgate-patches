+#[tokio::test]
+async fn runtime_admission_override_beats_the_file_acl() {
+    use crate::node::acl::PeerAclContext;
+
+    let (dir, mut node) = make_acl_node();
+    let allowed = Identity::generate();
+    let denied = Identity::generate();
+    std::fs::write(allow_path(&dir), format!("{}\n", allowed.npub())).unwrap();
+    std::fs::write(deny_path(&dir), "ALL\n").unwrap();
+    node.reload_peer_acl().await;
+
+    let allowed_id = PeerIdentity::from_pubkey_full(allowed.pubkey_full());
+    let denied_id = PeerIdentity::from_pubkey_full(denied.pubkey_full());
+    let addr = || TransportAddr::from_string("127.0.0.1:9000");
+    let transport = || TransportId::new(1);
+    let check = |node: &Node, id: &PeerIdentity| {
+        node.authorize_peer(id, PeerAclContext::InboundHandshake, transport(), &addr())
+    };
+
+    // Baseline: the files allow one and deny the other.
+    assert!(check(&node, &allowed_id).is_ok());
+    assert!(check(&node, &denied_id).is_err());
+
+    // Runtime deny overrides a file allow.
+    node.api_set_admission(&allowed.npub(), "deny").unwrap();
+    assert!(check(&node, &allowed_id).is_err());
+
+    // Runtime allow overrides a file deny.
+    node.api_set_admission(&denied.npub(), "allow").unwrap();
+    assert!(check(&node, &denied_id).is_ok());
+
+    // `clear` falls back to the files.
+    node.api_set_admission(&allowed.npub(), "clear").unwrap();
+    node.api_set_admission(&denied.npub(), "clear").unwrap();
+    assert!(check(&node, &allowed_id).is_ok());
+    assert!(check(&node, &denied_id).is_err());
+
+    // An unknown action is refused, not silently treated as clear.
+    assert!(node.api_set_admission(&allowed.npub(), "maybe").is_err());
+}
